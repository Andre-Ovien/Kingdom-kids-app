    "CLOUDINARY_PRIVATE_DELIVERY_ENABLED": false,
    "SQUARE_SANDBOX_HTTP_TRANSPORT_ENABLED": false,
    "PARENT_CHECKOUT_SANDBOX_ENABLED": false,
    "PARENT_CONTENT_ACCESS_STATUS_ENABLED": false
  },
  "required_production_inputs_not_collected": [
    "owner-selected Render account, service name, repository commit, same-region topology and compute plans",
    "exact API/admin hostnames and verified ingress forwarding/proxy count",
    "independent Django and JWT secrets plus three independent account-challenge peppers",
    "stable JWT issuer and audience",
    "qualified PostgreSQL connection, TLS configuration, restore-tested backups and retention",
    "shared cache connection with qualified transport/auth/persistence and memory policy",
    "qualified SMTP sender domain, transport and secret-manager credentials",
    "approved content-only bootstrap and narration metadata installation workflow",
    "image digest, in-image dependency/static/ZoneInfo check and staging release acceptance",
    "actual production legal contact, retention and media-rights sign-off remain separate release inputs"
  ],
  "known_constraints": {
    "render_http_health_accepts_3xx": true,
    "render_health_budget_seconds": 5,
    "application_dependency_failure_timeouts_may_exceed_health_budget": true,
    "free_web_blocks_smtp_465_and_587": true,
    "pre_deploy_requires_paid_service": true,
    "free_postgres_expiry_days": 30,
    "no_runtime_media_binaries_packaged": true,
    "production_media_and_financial_activation_qualified": false
  },
  "actions_performed": {
