  "future_release_commands_once_after_backup": [
    "python scripts/render_preflight.py --image",
    "python Core/manage.py check --deploy",
    "python Core/manage.py migrate --noinput"
  ],
  "activation_overrides": {
    "SQUARE_SANDBOX_ENABLED": false,
    "SQUARE_SANDBOX_CHECKOUT_ENABLED": false,
