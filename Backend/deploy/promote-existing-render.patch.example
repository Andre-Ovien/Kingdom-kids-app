--- a/render.yaml
+++ b/render.yaml
@@ -3,13 +3,15 @@
   - type: web
     name: kingdom-kids-checkout-staging
     runtime: docker
-    plan: free
+    plan: 0.5c-512mb
     region: virginia
     branch: main
     rootDir: Backend
     dockerfilePath: ./Dockerfile
     dockerContext: .
-    autoDeployTrigger: commit
+    autoDeployTrigger: "off"
+    domains:
+      - api.kingdom-kids.app
     healthCheckPath: /health/ready/
     envVars:
       - key: DJANGO_DEBUG
@@ -100,15 +102,17 @@
         sync: false
   - type: keyvalue
     name: kingdom-kids-cache
-    plan: free
+    plan: 256mb
     region: virginia
     ipAllowList: []
     maxmemoryPolicy: noeviction
-    persistenceMode: "off"
+    persistenceMode: journal-snapshot
 
 databases:
   - name: kingdom-kids-db
-    plan: free
+    plan: 0.1c-256mb
+    # Existing database: omit diskSizeGB to preserve its actual allocation.
+    storageAutoscalingEnabled: false
     region: virginia
     databaseName: kingdom_kids
     user: kingdom_kids
