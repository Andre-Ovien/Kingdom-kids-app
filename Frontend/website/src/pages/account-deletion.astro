---
import PublicPageLayout from '../layouts/PublicPageLayout.astro';
import { privacyContact } from '../config/site';

const description =
  'Request permanent deletion of a Kingdom Kids grown-up account and its associated family data.';
---

<PublicPageLayout
  title="Request account deletion"
  description={description}
  canonicalPath="/account-deletion/"
  mainClass="public-main--deletion"
>
  <header class="public-hero deletion-hero">
    <p class="public-eyebrow">Privacy &amp; account</p>
    <h1>Request account deletion.</h1>
    <p class="public-lead">
      You can ask us to permanently delete your Kingdom Kidsvaccount and the family data connected to it.
      We’ll verify the account before anything is removed.
    </p>
    <p class="deletion-safety" id="deletion-safety">
      <strong>Keep your credentials private.</strong> Never enter your password, a child’s name, or a code from any
      other Kingdom Kids email on this page.
    </p>
  </header>

  <div class="deletion-layout">
    <article class="deletion-card" aria-labelledby="deletion-request-title">
      <div data-deletion-request-stage>
        <p class="public-eyebrow">Start here</p>
        <h2 id="deletion-request-title">Send a deletion request</h2>
        <p>
          Enter the email address on the account. We’ll send a short-lived code so you can prove that you
          control the address. Nothing is deleted at this step.
        </p>

        <form
          class="deletion-form"
          data-deletion-request-form
          action="/account-deletion/"
          method="post"
          aria-describedby="deletion-email-help deletion-safety"
          aria-busy="false"
          novalidate
        >
          <fieldset data-deletion-request-fields disabled>
            <div class="form-field">
              <label for="deletion-email">Email address on the account</label>
              <input
                id="deletion-email"
                type="email"
                inputmode="email"
                autocomplete="email"
                maxlength="254"
                aria-describedby="deletion-email-help deletion-request-status"
                required
                data-deletion-email
              />
              <small id="deletion-email-help">
                We’ll use this address only to locate the account and send verification instructions.
              </small>
            </div>

            <button class="delete-button delete-button--request" type="submit" data-deletion-request-submit>
              Send verification code
            </button>
          </fieldset>

          <p
            class="form-status"
            id="deletion-request-status"
            role="status"
            aria-live="polite"
            aria-atomic="true"
            tabindex="-1"
            data-deletion-request-status
          ></p>
        </form>
      </div>

      <section
        class="deletion-confirmation"
        aria-labelledby="deletion-confirm-title"
        hidden
        data-deletion-confirmation-stage
      >
        <p class="public-eyebrow">Check your inbox</p>
        <h2 id="deletion-confirm-title" tabindex="-1">Confirm account deletion</h2>
        <p>
          Enter the six-digit code from the Kingdom Kids deletion email. This final confirmation permanently removes
          the account and active-service data listed on this page.
        </p>

        <form
          class="deletion-form deletion-form--confirm"
          data-deletion-confirm-form
          action="/account-deletion/"
          method="post"
          aria-describedby="deletion-code-help deletion-confirmation-help"
          aria-busy="false"
          novalidate
          autocomplete="off"
        >
          <fieldset data-deletion-confirm-fields disabled>
            <div class="form-field">
              <label for="deletion-code">Six-digit deletion code</label>
              <input
                id="deletion-code"
                type="text"
                inputmode="numeric"
                autocomplete="one-time-code"
                maxlength="6"
                pattern="[0-9]{6}"
                aria-describedby="deletion-code-help deletion-confirm-status"
                required
                data-deletion-code
              />
              <small id="deletion-code-help">The code expires shortly and can be used only once.</small>
            </div>

            <label class="deletion-acknowledgement" id="deletion-confirmation-help">
              <input type="checkbox" required data-deletion-confirmation />
              <span>I understand that deleting this account and its associated family data cannot be undone.</span>
            </label>

            <button class="delete-button delete-button--danger" type="submit" data-deletion-confirm-submit>
              Delete my account and data
            </button>
          </fieldset>

          <p
            class="form-status"
            id="deletion-confirm-status"
            role="status"
            aria-live="polite"
            aria-atomic="true"
            tabindex="-1"
            data-deletion-confirm-status
          ></p>
        </form>
      </section>

      <section class="deletion-complete" hidden data-deletion-complete>
        <p class="public-eyebrow">Request complete</p>
        <h2 tabindex="-1" data-deletion-complete-title>Your account has been deleted.</h2>
        <p>
          The Kingdom Kids account and its associated data have been removed from the active service. You can now
          close this page.
        </p>
      </section>

      <noscript>
        <p class="danger-notice">
          JavaScript is required for the secure verification step. If it is unavailable, email
          <a href={privacyContact.href}>{privacyContact.email}</a> to request help.
        </p>
      </noscript>
    </article>

    <aside class="deletion-side" aria-label="How account deletion works">
      <section>
        <p class="public-eyebrow">The process</p>
        <ol class="deletion-steps">
          <li><strong>1. Request</strong> Enter the email used for the account.</li>
          <li><strong>2. Verify</strong> Open the email and enter the secure six-digit code.</li>
          <li><strong>3. Delete</strong> Confirm once more, then the account and connected data are removed.</li>
        </ol>
      </section>

      <section class="deletion-data-note">
        <h2>What will be deleted</h2>
        <ul>
          <li>The account.</li>
          <li>Child profiles and reading preferences.</li>
          <li>Story activity and streak history.</li>
          <li>Game progress, scores, and attempts.</li>
          <li>A waitlist entry using the same verified email.</li>
        </ul>
        <p>
          Published stories and games are not personal account data and remain available. Some deleted information
          may remain temporarily in access-restricted backups until normal rotation; it is not restored to the active
          service except for disaster recovery.
        </p>
      </section>

      <p class="deletion-help">
        Need help or no longer have access to that email?
        <a href={privacyContact.href}>Contact {privacyContact.email}</a>.
      </p>
    </aside>
  </div>

  <script>
    const requestForm = document.querySelector<HTMLFormElement>('[data-deletion-request-form]');
    const requestFields = document.querySelector<HTMLFieldSetElement>('[data-deletion-request-fields]');
    const emailInput = document.querySelector<HTMLInputElement>('[data-deletion-email]');
    const requestButton = document.querySelector<HTMLButtonElement>('[data-deletion-request-submit]');
    const requestStatus = document.querySelector<HTMLElement>('[data-deletion-request-status]');
    const requestStage = document.querySelector<HTMLElement>('[data-deletion-request-stage]');

    const confirmationStage = document.querySelector<HTMLElement>('[data-deletion-confirmation-stage]');
    const confirmationTitle = document.querySelector<HTMLElement>('#deletion-confirm-title');
    const confirmForm = document.querySelector<HTMLFormElement>('[data-deletion-confirm-form]');
    const confirmFields = document.querySelector<HTMLFieldSetElement>('[data-deletion-confirm-fields]');
    const codeInput = document.querySelector<HTMLInputElement>('[data-deletion-code]');
    const confirmationInput = document.querySelector<HTMLInputElement>('[data-deletion-confirmation]');
    const confirmButton = document.querySelector<HTMLButtonElement>('[data-deletion-confirm-submit]');
    const confirmStatus = document.querySelector<HTMLElement>('[data-deletion-confirm-status]');

    const completeStage = document.querySelector<HTMLElement>('[data-deletion-complete]');
    const completeTitle = document.querySelector<HTMLElement>('[data-deletion-complete-title]');
    let deletionChallengeId = '';

    const setStatus = (
      region: HTMLElement | null,
      state: 'idle' | 'loading' | 'error' | 'success',
      message: string,
      focus = false,
    ) => {
      if (!region) return;
      region.dataset.state = state;
      region.setAttribute('role', state === 'error' ? 'alert' : 'status');
      region.textContent = message;
      if (focus) region.focus();
    };

    const setRequestBusy = (busy: boolean) => {
      if (!requestForm || !requestFields || !requestButton) return;
      requestForm.setAttribute('aria-busy', String(busy));
      requestFields.disabled = busy;
      requestButton.textContent = busy ? 'Sending…' : 'Send verification code';
    };

    const setConfirmBusy = (busy: boolean) => {
      if (!confirmForm || !confirmFields || !confirmButton) return;
      confirmForm.setAttribute('aria-busy', String(busy));
      confirmFields.disabled = busy;
      confirmButton.textContent = busy ? 'Deleting account…' : 'Delete my account and data';
    };

    const timedFetch = async (input: RequestInfo | URL, init: RequestInit) => {
      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 15000);
      try {
        return await fetch(input, { ...init, signal: controller.signal });
      } finally {
        window.clearTimeout(timeout);
      }
    };

    const jsonRequest = (body: object): RequestInit => ({
      method: 'POST',
      headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
      cache: 'no-store',
      credentials: 'omit',
      referrerPolicy: 'same-origin',
    });

    if (requestForm && requestFields && emailInput && requestButton) {
      requestForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        emailInput.setAttribute('aria-invalid', 'false');

        if (!emailInput.value.trim() || !emailInput.validity.valid) {
          emailInput.setAttribute('aria-invalid', 'true');
          setStatus(
            requestStatus,
            'error',
            'Enter the email address used for your Kingdom Kids account.',
          );
          emailInput.focus();
          return;
        }
        if (!navigator.onLine) {
          setStatus(requestStatus, 'error', 'You appear to be offline. Reconnect and try again.', true);
          return;
        }

        setRequestBusy(true);
        setStatus(requestStatus, 'loading', 'Sending verification instructions…');

        try {
          const response = await timedFetch(
            '/api/accounts/account-deletion/request/',
            jsonRequest({ email: emailInput.value.trim() }),
          );

          if (response.status === 202) {
            const payload: unknown = await response.json();
            if (
              typeof payload !== 'object' ||
              payload === null ||
              !('challenge_id' in payload) ||
              typeof payload.challenge_id !== 'string' ||
              payload.challenge_id.length === 0
            ) {
              throw new Error('Invalid deletion-request response.');
            }

            deletionChallengeId = payload.challenge_id;
            if (confirmationStage && confirmFields) {
              confirmationStage.hidden = false;
              confirmFields.disabled = false;
            }
            setStatus(
              requestStatus,
              'success',
              'If a Kingdom Kids account matches that email, we sent the next step. Check your inbox and spam folder. The account has not been deleted yet.',
            );
            requestButton.textContent = 'Send another code';
            confirmationTitle?.focus();
          } else if (response.status === 429) {
            setStatus(requestStatus, 'error', 'Too many requests. Wait a while, then try again.', true);
          } else {
            setStatus(
              requestStatus,
              'error',
              'We couldn’t send the request right now. Try again later or email privacy@kingdom-kids.app.',
              true,
            );
          }
        } catch (error) {
          const message = error instanceof DOMException && error.name === 'AbortError'
            ? 'The request took too long. Try again later or email privacy@kingdom-kids.app.'
            : 'We couldn’t reach the service. Check your connection and try again.';
          setStatus(requestStatus, 'error', message, true);
        } finally {
          setRequestBusy(false);
          if (deletionChallengeId) requestButton.textContent = 'Send another code';
        }
      });

      requestFields.disabled = false;
    }

    if (
      confirmForm &&
      confirmFields &&
      codeInput &&
      confirmationInput &&
      confirmButton
    ) {
      confirmForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        codeInput.setAttribute('aria-invalid', 'false');

        if (!deletionChallengeId) {
          setStatus(confirmStatus, 'error', 'Request a new verification code before continuing.', true);
          emailInput?.focus();
          return;
        }
        if (!/^[0-9]{6}$/.test(codeInput.value)) {
          codeInput.setAttribute('aria-invalid', 'true');
          setStatus(confirmStatus, 'error', 'Enter the six-digit code from the deletion email.');
          codeInput.focus();
          return;
        }
        if (!confirmationInput.checked) {
          setStatus(confirmStatus, 'error', 'Confirm that you understand this deletion cannot be undone.');
          confirmationInput.focus();
          return;
        }
        if (!navigator.onLine) {
          setStatus(confirmStatus, 'error', 'You appear to be offline. Reconnect and try again.', true);
          return;
        }

        setConfirmBusy(true);
        setStatus(confirmStatus, 'loading', 'Deleting the account and connected family data…');

        try {
          const response = await timedFetch(
            '/api/accounts/account-deletion/confirm/',
            jsonRequest({
              challenge_id: deletionChallengeId,
              code: codeInput.value,
              confirmation: 'DELETE',
            }),
          );

          if (response.status === 204) {
            deletionChallengeId = '';
            requestForm?.reset();
            confirmForm.reset();
            if (requestFields) requestFields.disabled = true;
            confirmFields.disabled = true;
            if (requestStage) requestStage.hidden = true;
            if (confirmationStage) confirmationStage.hidden = true;
            if (completeStage) completeStage.hidden = false;
            completeTitle?.focus();
          } else if (response.status === 400) {
            setStatus(
              confirmStatus,
              'error',
              'That deletion code is incorrect or has expired. Request a new code and try again.',
              true,
            );
          } else if (response.status === 429) {
            setStatus(confirmStatus, 'error', 'Too many attempts. Wait a while, then try again.', true);
          } else {
            setStatus(
              confirmStatus,
              'error',
              'We couldn’t complete the deletion right now. Try again later or email privacy@kingdom-kids.app.',
              true,
            );
          }
        } catch (error) {
          const message = error instanceof DOMException && error.name === 'AbortError'
            ? 'The deletion request took too long. Check the account before trying again.'
            : 'We couldn’t reach the service. No deletion was confirmed; check the account before retrying.';
          setStatus(confirmStatus, 'error', message, true);
        } finally {
          if (!completeStage || completeStage.hidden) setConfirmBusy(false);
          codeInput.value = '';
          confirmationInput.checked = false;
        }
      });
    }

    window.addEventListener('pagehide', () => {
      deletionChallengeId = '';
      if (codeInput) codeInput.value = '';
    });
  </script>
</PublicPageLayout>
