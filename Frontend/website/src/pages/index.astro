---
import '@fontsource-variable/bricolage-grotesque/wght.css';
import '../styles/global.css';
import { siteConfig } from '../config/site';

const currentYear = new Date().getFullYear();
const siteOrigin = Astro.site ?? new URL(siteConfig.origin);
const canonicalUrl = new URL('/', siteOrigin);

const appSections = [
  {
    eyebrow: 'Stories',
    number: '01',
    title: 'Stories that stay with them.',
    description: 'Colorful Bible adventures with read-aloud support.',
    type: 'stories',
    theme: 'lilac',
  },
  {
    eyebrow: 'Games',
    number: '02',
    title: 'Play with purpose.',
    description: 'Bible games that bring familiar lessons back through play.',
    type: 'games',
    theme: 'sunshine',
  },
  {
    eyebrow: 'Videos',
    number: '03',
    title: 'A new way to watch.',
    description: 'Short Bible videos are planned for a future update.',
    status: 'Coming later',
    type: 'videos',
    theme: 'coral',
  },
];

const faqs = [
  {
    question: 'What is Kingdom Kids?',
    answer:
      'A playful faith-learning app where children explore Bible stories through reading, read-along audio and games.',
  },
  {
    question: 'Who is it made for?',
    answer:
      'Young explorers and the grown-ups guiding them, with simple activities for independent or shared play.',
  },
  {
    question: 'Will the first release include videos?',
    answer:
      'Not yet. The first beta focuses on stories, read-along audio and games; videos will follow in a later update.',
  },
  {
    question: 'Can grown-ups follow along?',
    answer:
      'Yes. Family profiles and gentle progress views help grown-ups stay involved without turning faith into a score.',
  },
  {
    question: 'Where will it launch first?',
    answer:
      'The first beta is being prepared for Android on Google Play. Join the waitlist for launch news.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#f4f0e6" />
    <meta name="description" content={siteConfig.description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content="Kingdom Kids — Big stories for little hearts" />
    <meta property="og:description" content={siteConfig.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Kingdom Kids — Big stories for little hearts" />
    <meta name="twitter:description" content={siteConfig.description} />
    <script>
      import { initWaitlistForms } from '../scripts/waitlist.mjs';
      initWaitlistForms();
    </script>

    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="preload" as="image" href="/images/hero/nia-reading-headline-v1.webp" fetchpriority="high" />
    <title>Kingdom Kids — Big stories for little hearts</title>
  </head>

  <body id="top">
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header" aria-label="Primary navigation" data-site-header>
      <div class="header-shell">
        <a class="brand" href="#top" aria-label="Kingdom Kids home">
          <span class="brand-symbol" aria-hidden="true"><i></i><i></i></span>
          <span>Kingdom Kids</span>
        </a>

        <nav class="desktop-nav" aria-label="Main menu">
          <a href="#experience">Explore the app</a>
          <a href="#faith-note">For grown-ups</a>
          <a href="#faqs">FAQs</a>
          <a href="/privacy/">Privacy</a>
        </nav>

        <a class="header-cta" href="#join">Join waitlist <span class="action-arrow" aria-hidden="true">&#x2197;&#xfe0e;</span></a>

        <button
          class="menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-haspopup="true"
          data-menu-toggle
        >
          <span class="sr-only" data-menu-label>Open navigation menu</span>
          <span class="menu-icon" aria-hidden="true"><i></i><i></i></span>
        </button>
      </div>

      <div class="scroll-progress" aria-hidden="true"><i></i></div>

      <div class="mobile-menu" id="mobile-menu" aria-hidden="true" data-mobile-menu>
        <nav aria-label="Mobile menu">
          <a href="#top"><span>01</span> Home</a>
          <a href="#experience"><span>02</span> Explore the app</a>
          <a href="#faith-note"><span>03</span> For grown-ups</a>
          <a href="#faqs"><span>04</span> FAQs</a>
          <a href="/privacy/"><span>05</span> Privacy</a>
          <a class="mobile-menu-cta" href="#join">Join the waitlist <span class="action-arrow" aria-hidden="true">&#x2197;&#xfe0e;</span></a>
        </nav>
      </div>
    </header>

    <button
      class="nav-backdrop"
      type="button"
      tabindex="-1"
      aria-label="Close navigation menu"
      data-nav-backdrop
    ></button>

    <main id="main-content" data-menu-background>
      <section class="editorial-hero" aria-labelledby="hero-title">
        <span class="hero-sequence" aria-hidden="true">01 — 04</span>
        <span class="hero-side-label" aria-hidden="true">Faith / wonder / play</span>

        <div class="hero-heading-wrap">
          <p class="hero-kicker"><span aria-hidden="true">✦</span> A joyful world made for young explorers</p>

          <h1 id="hero-title">
            <span class="hero-line">
              Big
              <span class="hero-face hero-face--nia" aria-hidden="true">
                <img
                  src="/images/hero/nia-reading-headline-v1.webp"
                  width="500"
                  height="500"
                  alt=""
                  decoding="async"
                  fetchpriority="high"
                />
              </span>
              stories
            </span>
            <span class="hero-line">
              <span class="hero-leaf hero-leaf--coral" aria-hidden="true"></span>
              for little
              <span class="hero-mobile-break" aria-hidden="true"></span>
              <span class="hero-face hero-face--zuri" aria-hidden="true">
                <img
                  src="/images/hero/zuri-clap-headline-v1.webp"
                  width="500"
                  height="500"
                  alt=""
                  decoding="async"
                />
              </span>
              hearts
            </span>
            <span class="hero-line">
              ready
              <span class="hero-mobile-break" aria-hidden="true"></span>
              <span class="hero-face hero-face--kai" aria-hidden="true">
                <img
                  src="/images/hero/kai-jump-headline-v1.webp"
                  width="500"
                  height="500"
                  alt=""
                  decoding="async"
                />
              </span>
              to grow
              <span class="hero-leaf hero-leaf--yellow" aria-hidden="true"></span>
            </span>
          </h1>
        </div>

        <div class="hero-foot">
          <div class="hero-intro">
            <p>
              Bible stories, warm read-along voices and playful challenges—made for curious little hearts and the
              grown-ups guiding them.
            </p>
            <a class="primary-action" href="#join">Save their spot <span class="action-arrow" aria-hidden="true">&#x2197;&#xfe0e;</span></a>
          </div>

          <a class="scroll-cue" href="#experience">
            <span aria-hidden="true">↓</span>
            <span>Explore the app</span>
          </a>

          <p class="hero-release"><span>Android beta</span> Coming first to Google Play</p>
        </div>

        <span class="hero-doodle hero-doodle--loop" aria-hidden="true"></span>
        <span class="hero-doodle hero-doodle--burst" aria-hidden="true">✦</span>
      </section>

      <section class="experience-section" id="experience" aria-labelledby="experience-title">
        <div class="section-index section-index--experience" aria-hidden="true">
          <span>02</span><i></i><span>Explore</span>
        </div>

        <div class="experience-shell">
          <header class="experience-header">
            <div class="experience-heading" data-reveal>
              <p class="section-kicker section-kicker--dark">
                <span aria-hidden="true">✦</span> Stories. Games. Videos.
              </p>
              <h2 id="experience-title">Three worlds.<br /><em>One joyful app.</em></h2>
            </div>

            <div class="experience-intro" data-reveal>
              <p>
                Stories and Bible games lead the first Android beta. Videos are planned for a later update.
              </p>
              <a class="primary-action experience-cta" href="#join">
                Join the waitlist <span class="action-arrow" aria-hidden="true">&#x2197;&#xfe0e;</span>
              </a>
            </div>
          </header>

          <p class="sr-only" id="experience-scroll-help">
            On smaller screens, the slides advance automatically. Swipe sideways or use the slide buttons below to
            explore all three app areas.
          </p>
          <ul
            class="experience-steps"
            aria-label="Explore the Kingdom Kids app"
            aria-describedby="experience-scroll-help"
            tabindex="0"
            data-experience-rail
          >
            {appSections.map((section) => (
              <li class="experience-step" data-experience-slide>
                <div class="experience-step-inner" data-reveal>
                  <div class="experience-step-meta">
                    <p><i aria-hidden="true"></i>{section.eyebrow}</p>
                    <span>{section.number}</span>
                  </div>

                  <article class={`experience-card experience-card--${section.theme}`}>
                    {section.type === 'stories' && (
                      <div class="pen-scene pen-scene--stories" aria-hidden="true">
                        <span class="pen-story-arc arc-a"></span>
                        <span class="pen-story-arc arc-b"></span>
                        <span class="pen-story-sheet sheet-b"><i></i></span>
                        <span class="pen-story-origin"></span>
                        <span class="pen-story-terminal"></span>
                      </div>
                      <img
                        class="feature-object-art story-books-art"
                        src="/images/sections/story-books-3d-v1.webp"
                        width="700"
                        height="700"
                        alt=""
                        loading="lazy"
                        decoding="async"
                        draggable="false"
                      />
                    )}

                    {section.type === 'games' && (
                      <div class="pen-scene pen-scene--games" aria-hidden="true">
                        <span class="pen-game-ramp ramp-a"></span>
                        <span class="pen-game-ramp ramp-b"></span>
                        <span class="pen-game-ramp ramp-c"></span>
                        <span class="pen-game-goal"></span>
                        <span class="pen-game-controls"><i></i></span>
                      </div>
                      <img
                        class="feature-object-art game-controller-art"
                        src="/images/sections/game-controller-3d-v1.webp"
                        width="700"
                        height="700"
                        alt=""
                        loading="lazy"
                        decoding="async"
                        draggable="false"
                      />
                    )}

                    {section.type === 'videos' && (
                      <div class="pen-scene pen-scene--videos" aria-hidden="true">
                        <span class="pen-video-orbit orbit-a"></span>
                        <span class="pen-video-orbit orbit-b"></span>
                        <span class="pen-video-playhead"></span>
                        <span class="pen-video-timeline"><i></i></span>
                      </div>
                      <img
                        class="feature-object-art video-clapper-art"
                        src="/images/sections/video-clapper-3d-v1.webp"
                        width="700"
                        height="700"
                        alt=""
                        loading="lazy"
                        decoding="async"
                        draggable="false"
                      />
                    )}

                    <div class="experience-card-caption">
                      {section.status && <span class="experience-card-status is-coming">{section.status}</span>}
                      <h3>{section.title}</h3>
                      <p>{section.description}</p>
                    </div>
                  </article>
                </div>
              </li>
            ))}
          </ul>
          <div class="experience-rail-tools" data-experience-controls hidden>
            <div class="experience-rail-dots" role="group" aria-label="Choose an app area">
              {appSections.map((section, index) => (
                <button
                  type="button"
                  class:list={{ 'is-active': index === 0 }}
                  aria-label={`Show ${section.eyebrow}`}
                  aria-current={index === 0 ? 'true' : undefined}
                  data-experience-dot
                ></button>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="faith-note-section" id="faith-note" aria-labelledby="faith-note-title">
        <div class="faith-note-ticker" aria-hidden="true">
          <div class="faith-note-ticker-track">
            <div class="faith-note-ticker-sequence">
              <span>Stories to share</span><i>✦</i><span>Read-along audio</span><i>✦</i><span>Playful Bible games</span><i>✦</i><span>Android beta</span><i>✦</i>
            </div>
            <div class="faith-note-ticker-sequence" aria-hidden="true">
              <span>Stories to share</span><i>✦</i><span>Read-along audio</span><i>✦</i><span>Playful Bible games</span><i>✦</i><span>Android beta</span><i>✦</i>
            </div>
          </div>
        </div>

        <div class="faith-note-shell">
          <div class="faith-note-sticker" aria-hidden="true" data-reveal>
            <div class="faith-note-sticker-card">
              <strong><span>HEART</span><span>TALK</span></strong>
              <small>KINGDOM KIDS <i></i> GROWN-UP NOTES</small>
            </div>
            <img
              class="faith-note-sun"
              src="/images/decor/heart-talk-sun-v1.png"
              width="418"
              height="446"
              alt=""
              loading="lazy"
              decoding="async"
              draggable="false"
            />
          </div>

          <h2 id="faith-note-title" data-reveal>
            If faith conversations feel harder than they should,
            <mark>here’s a gentler place to begin.</mark>
          </h2>

          <ul class="faith-note-points" data-reveal>
            <li>Children connect with Bible stories that feel welcoming, vivid and easy to revisit.</li>
            <li>Read-along audio lets them follow each story at a comfortable pace.</li>
            <li>Play gives familiar Bible moments another joyful way to stay with them.</li>
            <li>The next step can be as simple as one story and one question together.</li>
          </ul>

          <div class="faith-note-promise" data-reveal>
            <strong>You do not have to turn every moment into a lesson.</strong>
            <p>Kingdom Kids is being built to help you begin naturally—with a story, a little play, and room for the questions that follow.</p>
          </div>
        </div>
      </section>

      <section class="faq-section" id="faqs" aria-labelledby="faqs-title">
        <div class="faq-panel">
          <div class="faq-masthead" data-faq-draw>
            <svg
              viewBox="0 0 324 87"
              preserveAspectRatio="none"
              aria-hidden="true"
              focusable="false"
            >
              <path
                class="faq-masthead-line"
                d="M0 43C10 30 20 23 31 23C44 23 55 35 59 48C63 59 58 69 48 76C38 83 24 86 18 82C26 68 42 46 58 33C72 22 84 15 92 20C98 24 99 31 95 39C92 45 91 49 95 52C99 55 104 53 110 50C136 44 160 28 190 18C220 8 245 8 264 19C284 30 299 47 324 62"
              ></path>
            </svg>
            <h2 id="faqs-title">FAQ</h2>
          </div>

          <div class="faq-body">
            <div class="faq-art" aria-hidden="true" data-reveal>
              <img
                src="/images/decor/faq-qa-vector-v1.svg"
                width="156"
                height="137"
                alt=""
                loading="lazy"
                decoding="async"
                draggable="false"
              />
            </div>

            <div class="faq-list" data-reveal>
              {faqs.map((faq) => (
                <details name="kingdom-faq">
                  <summary>
                    <span class="faq-question">{faq.question}</span>
                    <span class="faq-toggle" aria-hidden="true"></span>
                  </summary>
                  <div class="faq-answer">
                    <div><p>{faq.answer}</p></div>
                  </div>
                </details>
              ))}
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer" id="join" data-menu-background>
      <div class="footer-shell">
        <section class="footer-signup" aria-labelledby="footer-signup-title" data-reveal>
          <div class="footer-signup-copy">
            <p class="footer-signup-eyebrow"><span aria-hidden="true">✦</span> Android beta · Google Play</p>
            <h2 id="footer-signup-title">Join the Kingdom Kids launch list.</h2>
          </div>

          <form
            class="waitlist-form"
            action="/api/accounts/waitlist/"
            method="post"
            accept-charset="UTF-8"
            novalidate
            data-waitlist-form
          >
            <label class="sr-only" for="waitlist-email">Email address</label>
            <div class="waitlist-controls">
              <input
                id="waitlist-email"
                name="email"
                type="email"
                inputmode="email"
                autocomplete="email"
                maxlength="254"
                placeholder="you@example.com"
                aria-describedby="waitlist-status"
                required
                data-waitlist-email
              />
              <button class="waitlist-submit" type="submit" data-waitlist-submit>
                <span class="waitlist-button-label" data-waitlist-button-label>Join the waitlist</span>
                <span class="action-arrow" aria-hidden="true">&#x2197;&#xfe0e;</span>
              </button>
            </div>
            <p
              class="waitlist-status"
              id="waitlist-status"
              role="status"
              aria-live="polite"
              aria-atomic="true"
              data-waitlist-status
            ></p>
          </form>
        </section>

        <div class="footer-meta" data-reveal>
          <div class="footer-brand-block">
            <a class="brand brand--footer" href="#top" aria-label="Kingdom Kids home">
              <span class="brand-symbol" aria-hidden="true"><i></i><i></i></span>
              <span>Kingdom Kids</span>
            </a>
            <p>Big stories for little hearts.</p>
          </div>

          <nav class="footer-nav" aria-label="Footer navigation">
            <div class="footer-nav-group">
              <p>Explore</p>
              <a href="#top">Home</a>
              <a href="#experience">Explore the app</a>
              <a href="#faith-note">For grown-ups</a>
              <a href="#faqs">FAQs</a>
            </div>
            <div class="footer-nav-group">
              <p>Privacy &amp; account</p>
              <a href="/contact/">Contact</a>
              <a href="/privacy/">Privacy</a>
              <a href="/account-deletion/">Account deletion</a>
            </div>
          </nav>

          <a class="footer-return" href="#top">
            <span aria-hidden="true">↑</span>
            <small>Back to top</small>
          </a>
        </div>

        <div class="footer-bottom">
          <p>&copy; {currentYear} Kingdom Kids</p>
          <p>Faith <span aria-hidden="true">·</span> Wonder <span aria-hidden="true">·</span> Play</p>
        </div>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const pageBody = document.body;
        const menuToggle = document.querySelector('[data-menu-toggle]');
        const mobileMenu = document.querySelector('[data-mobile-menu]');
        const menuLabel = document.querySelector('[data-menu-label]');
        const navBackdrop = document.querySelector('[data-nav-backdrop]');
        const menuBackgroundRegions = document.querySelectorAll('[data-menu-background]');
        const experienceRail = document.querySelector('[data-experience-rail]');
        const experienceSlides = [...document.querySelectorAll('[data-experience-slide]')];
        const experienceControls = document.querySelector('[data-experience-controls]');
        const experienceDots = [...document.querySelectorAll('[data-experience-dot]')];
        const experienceMobile = window.matchMedia('(max-width: 900px)');
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        let frame = 0;

        const menuFocusables = () => {
          if (!(menuToggle instanceof HTMLButtonElement) || !(mobileMenu instanceof HTMLElement)) return [];
          return [menuToggle, ...mobileMenu.querySelectorAll('a[href], button:not([disabled])')];
        };

        const setMenuState = (open, returnFocus = false) => {
          if (!(menuToggle instanceof HTMLButtonElement) || !(mobileMenu instanceof HTMLElement)) return;

          menuToggle.setAttribute('aria-expanded', String(open));
          mobileMenu.setAttribute('aria-hidden', String(!open));
          root.classList.toggle('menu-open', open);
          pageBody.classList.toggle('menu-open', open);
          menuBackgroundRegions.forEach((region) => {
            if (!(region instanceof HTMLElement)) return;
            if (open) region.setAttribute('inert', '');
            else region.removeAttribute('inert');
          });

          if (menuLabel) menuLabel.textContent = open ? 'Close navigation menu' : 'Open navigation menu';
          if (open) {
            window.requestAnimationFrame(() => {
              const firstLink = mobileMenu.querySelector('a[href]');
              if (firstLink instanceof HTMLElement) firstLink.focus();
            });
          } else if (returnFocus) {
            menuToggle.focus();
          }
        };

        menuToggle?.addEventListener('click', () => {
          if (!(menuToggle instanceof HTMLButtonElement)) return;
          setMenuState(menuToggle.getAttribute('aria-expanded') !== 'true');
        });

        navBackdrop?.addEventListener('click', () => setMenuState(false, true));
        mobileMenu?.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => setMenuState(false));
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && root.classList.contains('menu-open')) {
            setMenuState(false, true);
            return;
          }

          if (event.key === 'Tab' && root.classList.contains('menu-open')) {
            const focusables = menuFocusables();
            if (focusables.length === 0) return;
            const first = focusables[0];
            const last = focusables[focusables.length - 1];
            if (event.shiftKey && document.activeElement === first) {
              event.preventDefault();
              last.focus();
            } else if (!event.shiftKey && document.activeElement === last) {
              event.preventDefault();
              first.focus();
            }
          }
        });

        const faqDraw = document.querySelector('[data-faq-draw]');
        const faqLine = faqDraw?.querySelector('.faq-masthead-line');
        const faqLineSvg = faqLine?.ownerSVGElement;
        let faqLineResizeFrame = 0;

        const configureFaqLine = () => {
          if (
            !(faqDraw instanceof HTMLElement) ||
            !(faqLine instanceof SVGPathElement) ||
            !(faqLineSvg instanceof SVGSVGElement)
          ) return;

          const bounds = faqLineSvg.getBoundingClientRect();
          if (bounds.width <= 0 || bounds.height <= 0) return;

          const width = bounds.width;
          const height = bounds.height;
          const sourceHeight = 87;
          const sourceWidth = 324;
          const sourceJoin = 110;
          const motifScale = height / sourceHeight;
          const joinX = sourceJoin * motifScale;
          const tailScale = (width - joinX) / (sourceWidth - sourceJoin);
          const mapX = (value) => value <= sourceJoin
            ? value * motifScale
            : joinX + ((value - sourceJoin) * tailScale);
          const mapY = (value) => value * motifScale;
          const point = (x, y) => `${mapX(x).toFixed(2)} ${mapY(y).toFixed(2)}`;

          faqLineSvg.setAttribute('viewBox', `0 0 ${width.toFixed(2)} ${height.toFixed(2)}`);
          faqLine.setAttribute('d', [
            `M${point(0, 43)}`,
            `C${point(10, 30)} ${point(20, 23)} ${point(31, 23)}`,
            `C${point(44, 23)} ${point(55, 35)} ${point(59, 48)}`,
            `C${point(63, 59)} ${point(58, 69)} ${point(48, 76)}`,
            `C${point(38, 83)} ${point(24, 86)} ${point(18, 82)}`,
            `C${point(26, 68)} ${point(42, 46)} ${point(58, 33)}`,
            `C${point(72, 22)} ${point(84, 15)} ${point(92, 20)}`,
            `C${point(98, 24)} ${point(99, 31)} ${point(95, 39)}`,
            `C${point(92, 45)} ${point(91, 49)} ${point(95, 52)}`,
            `C${point(99, 55)} ${point(104, 53)} ${point(110, 50)}`,
            `C${point(136, 44)} ${point(160, 28)} ${point(190, 18)}`,
            `C${point(220, 8)} ${point(245, 8)} ${point(264, 19)}`,
            `C${point(284, 30)} ${point(299, 47)} ${point(324, 62)}`,
          ].join(' '));

          const length = faqLine.getTotalLength();
          faqLine.setAttribute('stroke-dasharray', `${length} ${length}`);
          faqLine.setAttribute(
            'stroke-dashoffset',
            faqDraw.classList.contains('is-visible') || reduceMotion.matches ? '0' : String(length),
          );
          faqDraw.classList.add('is-draw-ready');
          getComputedStyle(faqLine).strokeDashoffset;
        };

        configureFaqLine();

        if ('ResizeObserver' in window && faqLineSvg instanceof SVGSVGElement) {
          const faqLineResizeObserver = new ResizeObserver(() => {
            cancelAnimationFrame(faqLineResizeFrame);
            faqLineResizeFrame = requestAnimationFrame(configureFaqLine);
          });
          faqLineResizeObserver.observe(faqLineSvg);
        }

        const reveals = [...document.querySelectorAll('[data-reveal], [data-faq-draw]')];
        if (reduceMotion.matches || !('IntersectionObserver' in window)) {
          reveals.forEach((item) => item.classList.add('is-visible'));
        } else {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              });
            },
            { rootMargin: '0px 0px -12% 0px', threshold: 0.12 },
          );
          reveals.forEach((item) => observer.observe(item));
        }

        if (
          experienceRail instanceof HTMLElement &&
          experienceControls instanceof HTMLElement &&
          experienceSlides.length > 1
        ) {
          let experienceTimer = 0;
          let experienceScrollTimer = 0;
          let activeExperience = 0;
          let experienceDirection = 1;
          let experienceInView = false;
          let experienceHovering = false;
          let experiencePointerActive = false;
          let experienceFocused = false;

          const clearExperienceTimer = () => {
            window.clearTimeout(experienceTimer);
            experienceTimer = 0;
          };

          const canRotateExperience = () =>
            experienceMobile.matches &&
            !reduceMotion.matches &&
            experienceInView &&
            !document.hidden &&
            !experienceHovering &&
            !experiencePointerActive &&
            !experienceFocused &&
            experienceRail.scrollWidth > experienceRail.clientWidth + 2;

          const updateExperienceControls = () => {
            experienceControls.hidden = !experienceMobile.matches;
            experienceDots.forEach((dot, index) => {
              dot.classList.toggle('is-active', index === activeExperience);
              if (index === activeExperience) dot.setAttribute('aria-current', 'true');
              else dot.removeAttribute('aria-current');
            });
          };

          const closestExperienceSlide = () => {
            const railBounds = experienceRail.getBoundingClientRect();
            const styles = getComputedStyle(experienceRail);
            const snapInset = Number.parseFloat(styles.scrollPaddingInlineStart)
              || Number.parseFloat(styles.paddingInlineStart)
              || 0;
            const snapLine = railBounds.left + snapInset;
            let closestIndex = 0;
            let closestDistance = Number.POSITIVE_INFINITY;

            experienceSlides.forEach((slide, index) => {
              if (!(slide instanceof HTMLElement)) return;
              const bounds = slide.getBoundingClientRect();
              const distance = Math.abs(bounds.left - snapLine);
              if (distance < closestDistance) {
                closestDistance = distance;
                closestIndex = index;
              }
            });

            activeExperience = closestIndex;
            updateExperienceControls();
          };

          const scrollToExperience = (index) => {
            const slide = experienceSlides[index];
            if (!(slide instanceof HTMLElement)) return;

            const railBounds = experienceRail.getBoundingClientRect();
            const slideBounds = slide.getBoundingClientRect();
            const styles = getComputedStyle(experienceRail);
            const snapInset = Number.parseFloat(styles.scrollPaddingInlineStart)
              || Number.parseFloat(styles.paddingInlineStart)
              || 0;

            activeExperience = index;
            updateExperienceControls();
            experienceRail.scrollTo({
              left: experienceRail.scrollLeft + slideBounds.left - railBounds.left - snapInset,
              behavior: 'smooth',
            });
          };

          const scheduleExperienceRotation = () => {
            clearExperienceTimer();
            if (!canRotateExperience()) return;

            experienceTimer = window.setTimeout(() => {
              if (activeExperience >= experienceSlides.length - 1) experienceDirection = -1;
              else if (activeExperience <= 0) experienceDirection = 1;
              scrollToExperience(activeExperience + experienceDirection);
              scheduleExperienceRotation();
            }, 3000);
          };

          const pauseExperienceInteraction = () => {
            clearExperienceTimer();
          };

          experienceDots.forEach((dot, index) => {
            dot.addEventListener('click', () => {
              experienceDirection = index >= activeExperience ? 1 : -1;
              scrollToExperience(index);
            });
          });

          experienceRail.addEventListener('pointerdown', () => {
            experiencePointerActive = true;
            pauseExperienceInteraction();
          }, { passive: true });
          ['pointerup', 'pointercancel'].forEach((eventName) => {
            experienceRail.addEventListener(eventName, () => {
              experiencePointerActive = false;
              closestExperienceSlide();
              scheduleExperienceRotation();
            }, { passive: true });
          });
          experienceRail.addEventListener('wheel', () => {
            pauseExperienceInteraction();
            scheduleExperienceRotation();
          }, { passive: true });
          experienceRail.addEventListener('keydown', (event) => {
            if (['ArrowLeft', 'ArrowRight', 'Home', 'End', 'PageUp', 'PageDown'].includes(event.key)) {
              pauseExperienceInteraction();
            }
          });
          experienceRail.addEventListener('pointerenter', (event) => {
            if (event.pointerType !== 'mouse') return;
            experienceHovering = true;
            pauseExperienceInteraction();
          });
          experienceRail.addEventListener('pointerleave', (event) => {
            if (event.pointerType !== 'mouse') return;
            experienceHovering = false;
            scheduleExperienceRotation();
          });
          const experienceFocusRegions = [experienceRail, experienceControls];
          experienceFocusRegions.forEach((region) => {
            region.addEventListener('focusin', () => {
              experienceFocused = true;
              pauseExperienceInteraction();
            });
            region.addEventListener('focusout', () => {
              window.requestAnimationFrame(() => {
                experienceFocused = experienceFocusRegions.some((item) => item.contains(document.activeElement));
                if (!experienceFocused) scheduleExperienceRotation();
              });
            });
          });
          experienceRail.addEventListener('scroll', () => {
            window.clearTimeout(experienceScrollTimer);
            experienceScrollTimer = window.setTimeout(() => {
              closestExperienceSlide();
              scheduleExperienceRotation();
            }, 160);
          }, { passive: true });

          const experienceObserver = 'IntersectionObserver' in window
            ? new IntersectionObserver(([entry]) => {
                experienceInView = Boolean(entry?.isIntersecting && entry.intersectionRatio >= 0.35);
                if (!experienceInView) clearExperienceTimer();
                else scheduleExperienceRotation();
              }, { threshold: [0, 0.35, 0.7] })
            : null;

          if (experienceObserver) experienceObserver.observe(experienceRail);
          else experienceInView = true;

          const refreshExperienceRotation = () => {
            clearExperienceTimer();
            updateExperienceControls();
            if (!experienceMobile.matches) {
              experienceDirection = 1;
              activeExperience = 0;
            }
            scheduleExperienceRotation();
          };

          document.addEventListener('visibilitychange', refreshExperienceRotation);
          experienceMobile.addEventListener('change', refreshExperienceRotation);
          reduceMotion.addEventListener('change', refreshExperienceRotation);
          updateExperienceControls();
          scheduleExperienceRotation();
        }

        const render = () => {
          frame = 0;
          const scrollRange = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
          const progress = Math.min(1, Math.max(0, window.scrollY / scrollRange));
          root.style.setProperty('--scroll-progress', progress.toFixed(4));
          pageBody.classList.toggle('nav-scrolled', window.scrollY > 18);
        };

        const requestRender = () => {
          if (frame) return;
          frame = window.requestAnimationFrame(render);
        };

        window.addEventListener('scroll', requestRender, { passive: true });
        window.addEventListener('resize', () => {
          if (window.innerWidth > 860 && root.classList.contains('menu-open')) setMenuState(false);
          requestRender();
        }, { passive: true });
        window.addEventListener('pageshow', requestRender);
        requestRender();
      })();
    </script>
  </body>
</html>
