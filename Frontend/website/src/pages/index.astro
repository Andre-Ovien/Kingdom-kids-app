---
import '../styles/global.css';
import noahsArk from '../../../mobile/assets/images/onboarding/noahs-ark-v2.png';
import storyCelebration from '../../../mobile/assets/images/onboarding/story-celebration-v2.png';
import storyExplorer from '../../../mobile/assets/images/onboarding/story-explorer-v2.png';

type Step = {
  number: string;
  title: string;
  description: string;
  icon: 'book' | 'play' | 'crown';
};

type Feature = {
  label: string;
  title: string;
  description: string;
};

const navigation = [
  { label: 'Benefits', href: '#benefits' },
  { label: 'Stories', href: '#stories' },
  { label: 'How it works', href: '#how-it-works' },
  { label: 'Parents', href: '#parents' },
  { label: 'FAQs', href: '#faqs' },
  { label: 'Contact', href: '#contact' },
];

const steps: Step[] = [
  {
    number: '01',
    title: 'Choose',
    description: 'Pick a Bible adventure that matches their age, curiosity, or the lesson you are sharing today.',
    icon: 'book',
  },
  {
    number: '02',
    title: 'Explore',
    description: 'Read, watch, listen, and play through every story with bright moments that invite kids to join in.',
    icon: 'play',
  },
  {
    number: '03',
    title: 'Grow',
    description: 'Celebrate little wins and follow gentle progress as truth, courage, and kindness take root.',
    icon: 'crown',
  },
];

const features: Feature[] = [
  {
    label: 'Storytime',
    title: 'Big stories, made wonderfully clear.',
    description: 'Colorful retellings help young readers understand and remember the heart of every Bible story.',
  },
  {
    label: 'Playtime',
    title: 'Games with goodness built in.',
    description: 'Quick challenges turn memory, courage, and kindness into play they will want to revisit.',
  },
  {
    label: 'Family time',
    title: 'Simple ways to keep talking.',
    description: 'Helpful prompts give parents and teachers an easy bridge from screen time to real conversation.',
  },
];

const faqs = [
  {
    question: 'What ages is Kingdom Kids made for?',
    answer: 'Kingdom Kids is designed for curious children ages 4–10, with simple navigation for independent play and plenty of moments families can enjoy together.',
  },
  {
    question: 'Can parents follow their child’s progress?',
    answer: 'Yes. Gentle family progress helps grown-ups see completed stories, favorite activities, and learning rhythms without turning faith into a scorecard.',
  },
  {
    question: 'Is the experience safe for children?',
    answer: 'Safety is central to the experience. Kingdom Kids is designed around age-appropriate content, calm interactions, and a parent-friendly approach.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Kingdom Kids turns Bible stories into joyful adventures with stories, games, videos, and gentle family progress."
    />
    <meta name="theme-color" content="#0b0b0b" />
    <title>Kingdom Kids | Bible Adventures Made Joyful</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-shell" id="top">
      <header class="site-header" aria-label="Primary navigation">
        <a class="brand" href="#top" aria-label="Kingdom Kids home">
          <span class="brand-mark" aria-hidden="true">K</span>
          <span>Kingdom Kids</span>
        </a>

        <nav class="desktop-nav" aria-label="Main menu">
          {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
          <a class="header-action" href="#join">Join free</a>
        </nav>

        <details class="mobile-nav">
          <summary aria-label="Navigation menu">
            <span>Menu</span>
            <span class="menu-lines" aria-hidden="true"></span>
          </summary>
          <nav aria-label="Mobile menu">
            {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
            <a class="header-action" href="#join">Join free</a>
          </nav>
        </details>
      </header>

      <main id="main-content">
        <section class="hero-section" aria-labelledby="hero-title">
          <div class="hero-inner">
            <div class="hero-copy">
              <h1 id="hero-title" aria-label="Hello wonder">
                <span class="hero-word-bottom" aria-hidden="true">
                  <span class="hero-letter hero-letter-w">w</span>
                  <span class="hero-letter hero-letter-on"><span class="hero-word-top">hello</span>on</span>
                  <span class="hero-letter hero-letter-d">d</span>
                  <span class="hero-letter hero-letter-tail">er</span>
                </span>
              </h1>
              <p class="hero-subtitle">Bible adventures <span aria-hidden="true">....</span> made joyful</p>
              <p class="hero-description">
                A bright world of stories, games, and faith-filled discovery—made for curious little hearts.
              </p>
              <a class="button button-orange" href="#stories">Start exploring</a>
            </div>

            <div class="hero-art">
              <span class="hero-doodle hero-doodle-one" aria-hidden="true">✦</span>
              <span class="hero-doodle hero-doodle-two" aria-hidden="true">●</span>
              <img
                src={noahsArk.src}
                width={noahsArk.width}
                height={noahsArk.height}
                alt="A cheerful giraffe and elephant sailing in Noah's ark under a dove and smiling sun"
                loading="eager"
                fetchpriority="high"
              />
              <p class="art-note"><span aria-hidden="true">★</span> Read · Play · Grow</p>
            </div>
          </div>
        </section>

        <div class="wave-divider wave-pink-to-yellow" aria-hidden="true"></div>

        <section class="yellow-section" id="benefits">
          <span class="edge-star edge-star-left" aria-hidden="true"><i></i></span>
          <div class="edge-tiles" aria-hidden="true">
            <span>★</span>
            <span></span>
            <span></span>
          </div>

          <div class="section-container intro-grid">
            <div class="intro-art">
              <div class="art-platform" aria-hidden="true"></div>
              <img
                src={storyCelebration.src}
                width={storyCelebration.width}
                height={storyCelebration.height}
                alt="A joyful girl celebrates Bible stories while colorful story cards and stars float around her"
                loading="lazy"
              />
            </div>

            <div class="intro-copy">
              <p class="eyebrow">Faith that feels like an adventure</p>
              <h2>A joyful new way to grow.</h2>
              <p>
                Meet Kingdom Kids: a playful Bible-learning world where timeless stories become bright, memorable,
                everyday adventures.
              </p>
              <p>
                Children can read, watch, listen, and play—while families get simple ways to keep the learning going.
              </p>
            </div>
          </div>

          <section class="how-section section-container" id="how-it-works" aria-labelledby="how-title">
            <p class="section-kicker">Three little steps. One big adventure.</p>
            <h2 id="how-title">How it works</h2>

            <div class="step-grid">
              {steps.map((step) => (
                <article class="step-card">
                  <div class="step-visual" aria-hidden="true">
                    <span class={`step-symbol step-symbol-${step.icon}`}>
                      {step.icon === 'book' && <><i></i><i></i></>}
                      {step.icon === 'play' && <i></i>}
                      {step.icon === 'crown' && <><i></i><b></b></>}
                    </span>
                  </div>
                  <div class="step-heading">
                    <span>{step.number}</span>
                    <h3>{step.title}</h3>
                  </div>
                  <p>{step.description}</p>
                </article>
              ))}
            </div>
          </section>

          <section class="story-section section-container" id="stories" aria-labelledby="stories-title">
            <p class="section-kicker">One happy home for growing faith</p>
            <h2 id="stories-title">We’ve got you<span aria-hidden="true">...</span> stories, games &amp; growing together.</h2>

            <div class="story-billboard">
              <div class="billboard-image">
                <img
                  src="/images/hero-kingdom-illustration.png"
                  width="1983"
                  height="793"
                  alt="Children gathered around a screen showing colorful illustrated Bible stories"
                  loading="lazy"
                />
              </div>
              <div class="billboard-copy">
                <span class="mini-badge">Inside Kingdom Kids</span>
                <h3>Every tap opens a new story.</h3>
                <p>
                  From Noah’s courage to David’s bravery, each experience helps big truths feel clear, warm, and close
                  to home.
                </p>
                <a class="text-link" href="#join">See what’s waiting <span aria-hidden="true">→</span></a>
              </div>
            </div>

            <div class="feature-grid">
              {features.map((feature) => (
                <article class="feature-card">
                  <span>{feature.label}</span>
                  <h3>{feature.title}</h3>
                  <p>{feature.description}</p>
                </article>
              ))}
            </div>
          </section>
        </section>

        <div class="wave-divider wave-yellow-to-pink" aria-hidden="true"></div>

        <section class="parent-section" id="parents" aria-labelledby="parents-title">
          <div class="section-container parent-grid">
            <div class="parent-copy">
              <p class="eyebrow">Made for kids. Thoughtful for grown-ups.</p>
              <h2 id="parents-title">Big wonder.<br />Gentle guidance.</h2>
              <p>
                Kids get a world that feels playful and theirs. Parents get age-appropriate stories, calm design, and a
                simple view of what their child is enjoying.
              </p>

              <ul class="parent-list">
                <li><span aria-hidden="true">✓</span> Child-friendly by design</li>
                <li><span aria-hidden="true">✓</span> Meaningful screen time</li>
                <li><span aria-hidden="true">✓</span> Progress without pressure</li>
              </ul>

              <a class="button button-orange" href="#join">Bring the adventure home</a>
            </div>

            <div class="parent-art">
              <img
                src={storyExplorer.src}
                width={storyExplorer.width}
                height={storyExplorer.height}
                alt="A smiling child walks with an open blue Bible as a rainbow, dove, and stars rise from its pages"
                loading="lazy"
              />
              <div class="progress-note">
                <span>Today’s little win</span>
                <strong>2 stories explored</strong>
                <i aria-hidden="true"></i>
              </div>
            </div>
          </div>
        </section>

        <section class="faq-section" id="faqs" aria-labelledby="faq-title">
          <div class="section-container faq-grid">
            <div class="faq-heading">
              <p class="section-kicker">A few helpful answers</p>
              <h2 id="faq-title">Wondering something?</h2>
              <p>Here are the questions families ask us most.</p>
            </div>

            <div class="faq-list">
              {faqs.map((faq) => (
                <details>
                  <summary>{faq.question}<span aria-hidden="true">+</span></summary>
                  <p>{faq.answer}</p>
                </details>
              ))}
            </div>
          </div>
        </section>

        <section class="join-section" id="join" aria-labelledby="join-title">
          <div class="join-copy">
            <p>Ready when your little explorer is.</p>
            <h2 id="join-title">Let’s grow something good.</h2>
          </div>
          <a class="button button-cream" href="mailto:hello@kingdomkids.app?subject=Kingdom%20Kids%20early%20access">
            Join early access
          </a>
        </section>
      </main>

      <footer class="site-footer" id="contact">
        <a class="brand footer-brand" href="#top" aria-label="Back to the top">
          <span class="brand-mark" aria-hidden="true">K</span>
          <span>Kingdom Kids</span>
        </a>
        <p>Joyful Bible adventures for curious little hearts.</p>
        <a href="mailto:hello@kingdomkids.app">hello@kingdomkids.app</a>
      </footer>
    </div>
  </body>
</html>
