---
import PublicPageLayout from '../layouts/PublicPageLayout.astro';
import { policyDates, privacyContact } from '../config/site';

const description =
  'How Kingdom Kids handles parent accounts, child profiles, learning activity, device data, and waitlist information.';
---

<PublicPageLayout
  title="Privacy policy"
  description={description}
  canonicalPath="/privacy/"
  mainClass="public-main--privacy"
>
  <header class="privacy-intro">
    <h1>Privacy policy.</h1>
    <p class="public-lead">
      This policy explains how Kingdom Kids handles family information, why we use it, and the choices available
      to parents and guardians.
    </p>
    <p class="public-meta">Last updated: {policyDates.privacyLastUpdated}</p>
  </header>

  <div class="policy-layout">
    <nav class="policy-toc" aria-labelledby="privacy-toc-title" data-policy-toc>
      <h2 id="privacy-toc-title">On this page</h2>
      <ol>
        <li><a href="#scope-title"><span>01</span> Scope &amp; who it’s for</a></li>
        <li><a href="#collect-title"><span>02</span> Information we handle</a></li>
        <li><a href="#not-collect-title"><span>03</span> What we don’t collect</a></li>
        <li><a href="#use-title"><span>04</span> Why we use information</a></li>
        <li><a href="#share-title"><span>05</span> When information is shared</a></li>
        <li><a href="#retention-title"><span>06</span> Retention &amp; deletion</a></li>
        <li><a href="#children-title"><span>07</span> Children &amp; parent controls</a></li>
        <li><a href="#security-title"><span>08</span> Security</a></li>
        <li><a href="#choices-title"><span>09</span> Family choices &amp; rights</a></li>
        <li><a href="#changes-title"><span>10</span> Changes to this policy</a></li>
        <li><a href="#contact-title"><span>11</span> Contact</a></li>
      </ol>
    </nav>

    <article class="policy-card policy-article">
    <section class="policy-section" aria-labelledby="scope-title">
      <h2 id="scope-title">1. Scope and who the service is for</h2>
      <p>
        Kingdom Kids LLC operates Kingdom Kids. This policy applies to the Kingdom Kids website, iOS and Android apps,
        and supporting services. The app offers Bible stories, read-aloud features, games, and progress views for children
        ages 3–10, while a parent or guardian creates and manages the family account.
      </p>
      <p>
        Read-aloud features can use a device voice or prerecorded synthetic character narration delivered from
        our media providers. The app does not record a child’s voice.
      </p>
      <p>
        A child is not asked to create an account or provide an email address or password. Parents should use a
        nickname when creating a child profile.
      </p>
    </section>

    <section class="policy-section" aria-labelledby="collect-title">
      <h2 id="collect-title">2. Information we handle</h2>

      <h3>Parent account and security information</h3>
      <ul>
        <li>Parent email address and account identifiers.</li>
        <li>A protected password hash. We do not store the readable account password.</li>
        <li>
          Verification, password-reset and account-deletion records, including code expiry, failed attempts and
          security lockouts.
        </li>
        <li>Access and refresh tokens used to maintain a signed-in session.</li>
      </ul>

      <h3>Minimal child-profile information</h3>
      <ul>
        <li>A parent-entered display name or nickname and a chosen character/avatar.</li>
        <li>Reading preferences such as text size and whether narration is enabled.</li>
        <li>
          Learning activity tied to the profile: stories started or completed, game attempts and submitted answers,
          scores, stars, completed levels, badges, and the last-played time.
        </li>
        <li>Daily streak dates and the device timezone offset used to calculate a local day.</li>
      </ul>

      <h3>Website and waitlist information</h3>
      <ul>
        <li>A grown-up’s email, consent time, and signup source when they ask to join the launch waitlist.</li>
        <li>
          Technical request information used to deliver and protect the service, including IP or hosting-proxy
          address, request time, response status, request duration, browser information and security events.
        </li>
      </ul>

      <h3>Payments and subscription records</h3>
      <p>
        A parent who purchases access enters payment details on Square’s hosted checkout. Kingdom Kids does not
        ask a child for payment information and does not store a full payment-card number or card security code.
      </p>
      <ul>
        <li>
          We keep the selected plan, price and currency, accepted billing terms, checkout references,
          and Square customer, checkout-link, order, subscription, invoice and payment identifiers.
        </li>
        <li>
          We receive and verify the form of payment, payment and card-payment status, capture times, refunds,
          subscription and cancellation status, and the period of access supported by a verified payment.
        </li>
        <li>Square can return masked card information, such as card type and last four digits, with a payment record.</li>
        <li>Complimentary access, when provided, has separate access, expiry and revocation records.</li>
      </ul>

      <h3>Messages to our team</h3>
      <p>
        The website contact form sends the subject, reply email address and message to our support inbox through
        our email provider. We handle these messages through email, rather than a contact-message database. Please do
        not include passwords, verification codes, payment details or a child’s personal information in a message.
      </p>

      <h3>Information kept on the device</h3>
      <p>
        Session tokens, the selected profile, preferences, first-launch state, and optional reminder settings are
        stored using the device’s protected storage. Reminder notifications are scheduled locally after a grown-up
        grants notification permission.
      </p>
      <p>
        Some games use device motion locally for game controls. Motion readings stay on the device. Narration is
        playback or text-to-speech; the app does not record a child’s voice.
      </p>
    </section>

    <section class="policy-section" aria-labelledby="not-collect-title">
      <h2 id="not-collect-title">3. Information we do not collect</h2>
      <p>The app does not ask for or use:</p>
      <ul>
        <li>A child’s email address, password, birth date, school, home address, or precise location.</li>
        <li>Contacts, photos, camera, microphone, or advertising identifiers.</li>
        <li>Third-party advertising, behavioural advertising, or analytics services embedded in the app.</li>
      </ul>
    </section>

    <section class="policy-section" aria-labelledby="use-title">
      <h2 id="use-title">4. Why we use information</h2>
      <ul>
        <li>Create, verify, secure, and recover a parent account.</li>
        <li>Keep each child profile’s content preferences and progress separate.</li>
        <li>Evaluate game activity, award progress, and show family-facing summaries.</li>
        <li>Calculate streaks using the profile’s local day without requesting precise location.</li>
        <li>Deliver requested launch updates to waitlist subscribers.</li>
        <li>Open checkout, verify purchases and refunds, manage subscription cancellation, and provide access.</li>
        <li>Deliver contact messages and reply to requests for help.</li>
        <li>Prevent abuse, investigate errors, protect accounts, and operate the service.</li>
        <li>Comply with applicable law and respond to valid legal requests.</li>
      </ul>
    </section>

    <section class="policy-section" aria-labelledby="share-title">
      <h2 id="share-title">5. When information may be shared</h2>
      <p>Kingdom Kids does not sell or rent personal information.</p>
      <p>Information may be disclosed only as needed to:</p>
      <ul>
        <li>
          Service providers used to host and deliver the website, app services, database, media, payments and email, as
          described below.
        </li>
        <li>Comply with law, court orders, or valid government requests, or protect people and the service from harm.</li>
      </ul>
      <ul>
        <li>Render hosts the app’s servers, database and service-protection systems.</li>
        <li>Vercel hosts the public website and forwards supported form requests to our servers.</li>
        <li>Cloudinary delivers private story and narration media.</li>
        <li>Resend delivers account-security, waitlist and contact email.</li>
        <li>Square hosts parent checkout and processes payments and provider-managed subscription billing.</li>
        <li>Contact messages are delivered to the operator’s Google Gmail inbox.</li>
      </ul>
    </section>

    <section class="policy-section" aria-labelledby="retention-title">
      <h2 id="retention-title">6. Retention and deletion</h2>
      <ul>
        <li>Parent account and associated child-profile data are kept while the account remains open.</li>
        <li>
          Deleting the family account removes the parent account, child profiles, preferences, story activity,
          streak history, game progress and attempts, and a waitlist entry using the same email from the active
          service.
        </li>
        <li>
          Requests through the account-deletion page require a short-lived code sent to the parent email address.
          This option is also available for accounts waiting for email verification.
        </li>
        <li>
          You can ask us to remove waitlist-only information by contacting us.
        </li>
        <li>
          Verification, password-reset and account-deletion codes expire. Related security records can remain
          after a code can no longer be used.
        </li>
        <li>
          Checkout, payment and cancellation records remain after family-account deletion, with the link to the
          deleted account removed. This lets us resolve payments and requests to stop future billing. These
          records include provider identifiers, billing terms, amounts,
          payment and refund evidence, access dates and cancellation state.
        </li>
        <li>
          Deleting an account also requests cancellation of future subscription billing. If Square is unavailable,
          the cancellation request remains pending until we can verify that it has completed.
        </li>
        <li>
          Contact messages sent to our inbox and copies held by email or payment providers are not automatically
          erased when a family account is deleted.
        </li>
      </ul>
      <p>
        Financial records, support email, security logs and any backup copies may remain after family-account
        deletion. Contact us if you have a question about information that remains associated with a purchase
        or support request.
      </p>
    </section>

    <section class="policy-section" aria-labelledby="children-title">
      <h2 id="children-title">7. Children and parent controls</h2>
      <p>
        The child experience is attached to a grown-up’s verified account. A parent chooses the child-profile
        nickname and avatar, can review profile information and progress, and can delete the entire family account.
        Kingdom Kids does not use child-profile activity for advertising or build advertising profiles.
      </p>
      <p>
        If a child supplies information beyond what the app requests, contact us so we can investigate and help
        remove it.
      </p>
    </section>

    <section class="policy-section" aria-labelledby="security-title">
      <h2 id="security-title">8. Security</h2>
      <p>
        We use encrypted HTTPS connections, password hashing, parent-account access controls, limits on sensitive
        requests, and protected device storage for mobile sessions. No security measure provides absolute
        protection. Please contact us promptly about suspected account misuse or a security issue.
      </p>
    </section>

    <section class="policy-section" aria-labelledby="choices-title">
      <h2 id="choices-title">9. Family choices and rights</h2>
      <ul>
        <li>Use the <a href="/account-deletion/">account-deletion page</a> to permanently delete an account.</li>
        <li>Turn optional notifications off in the app or device settings.</li>
        <li>Ask to access, correct, or remove information, including a waitlist-only email.</li>
        <li>Exercise any additional privacy rights available in the family’s country or region.</li>
      </ul>
      <p>
        We may need to verify that a requester controls the relevant parent account or email before completing a request.
      </p>
    </section>

    <section class="policy-section" aria-labelledby="changes-title">
      <h2 id="changes-title">10. Changes to this policy</h2>
      <p>
        The revised date above shows when this policy was last updated. Please review the policy when you use
        our services.
      </p>
    </section>

    <section class="policy-section" aria-labelledby="contact-title">
      <h2 id="contact-title">11. Contact</h2>
      <p>
        Privacy questions or requests for Kingdom Kids LLC can be sent to
        <a href={privacyContact.href}>{privacyContact.email}</a>.
      </p>
    </section>
    </article>
  </div>

  <script>
    const privacyToc = document.querySelector<HTMLElement>('[data-policy-toc]');
    const privacySections = Array.from(document.querySelectorAll<HTMLElement>('.policy-article .policy-section'));
    const privacyLinks = privacyToc
      ? Array.from(privacyToc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'))
      : [];
    const privacyLinkById = new Map(
      privacyLinks.map((link) => [link.hash.slice(1), link]),
    );

    const setActivePrivacySection = (id: string) => {
      privacyLinks.forEach((link) => {
        const isActive = link.hash === `#${id}`;
        link.classList.toggle('is-active', isActive);
        if (isActive) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };

    if (privacySections.length > 0 && privacyLinks.length > 0) {
      setActivePrivacySection(privacySections[0].querySelector('h2')?.id ?? 'scope-title');

      const sectionObserver = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
          const heading = visible[0]?.target.querySelector<HTMLElement>('h2[id]');
          if (heading && privacyLinkById.has(heading.id)) setActivePrivacySection(heading.id);
        },
        { rootMargin: '-18% 0px -66% 0px', threshold: 0 },
      );

      privacySections.forEach((section) => sectionObserver.observe(section));
      privacyLinks.forEach((link) => {
        link.addEventListener('click', () => setActivePrivacySection(link.hash.slice(1)));
      });
    }
  </script>
</PublicPageLayout>
