---
import '@fontsource-variable/bricolage-grotesque/wght.css';
import '../styles/global.css';
import '../styles/public-page.css';

import { siteConfig } from '../config/site';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  mainClass?: string;
}

const { title, description, canonicalPath, mainClass = '' } = Astro.props;
const siteOrigin = Astro.site ?? new URL(siteConfig.origin);
const canonicalUrl = new URL(canonicalPath, siteOrigin);
const socialImageUrl = new URL(siteConfig.socialImagePath, siteOrigin);
const currentPath = Astro.url.pathname;
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#f8d866" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={`${title} | ${siteConfig.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="A pastel sky above the Kingdom Kids world" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | ${siteConfig.name}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />

    <title>{title} | {siteConfig.name}</title>
  </head>
  <body id="top" class="public-page-body">
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header" aria-label="Primary navigation" data-site-header>
      <div class="header-shell">
        <a class="brand" href="/" aria-label="Kingdom Kids home">
          <span class="brand-symbol" aria-hidden="true"><i></i><i></i></span>
          <span>Kingdom Kids</span>
        </a>

        <nav class="desktop-nav" aria-label="Main menu">
          <a href="/#experience">Explore the app</a>
          <a href="/#faith-note">For grown-ups</a>
          <a href="/#faqs">FAQs</a>
          <a href="/privacy/" aria-current={currentPath === '/privacy/' ? 'page' : undefined}>Privacy</a>
        </nav>

        <a class="header-cta" href="#join">
          Join waitlist <span class="action-arrow" aria-hidden="true">&#x2197;&#xfe0e;</span>
        </a>

        <button
          class="menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-haspopup="true"
          data-menu-toggle
        >
          <span class="sr-only" data-menu-label>Open navigation menu</span>
          <span class="menu-icon" aria-hidden="true"><i></i><i></i></span>
        </button>
      </div>

      <div class="scroll-progress" aria-hidden="true"><i></i></div>

      <div class="mobile-menu" id="mobile-menu" aria-hidden="true" data-mobile-menu>
        <nav aria-label="Mobile menu">
          <a href="/"><span>01</span> Home</a>
          <a href="/#experience"><span>02</span> Explore the app</a>
          <a href="/#faith-note"><span>03</span> For grown-ups</a>
          <a href="/#faqs"><span>04</span> FAQs</a>
          <a href="/privacy/" aria-current={currentPath === '/privacy/' ? 'page' : undefined}><span>05</span> Privacy</a>
          <a class="mobile-menu-cta" href="#join">
            Join the waitlist <span class="action-arrow" aria-hidden="true">&#x2197;&#xfe0e;</span>
          </a>
        </nav>
      </div>
    </header>

    <button
      class="nav-backdrop"
      type="button"
      tabindex="-1"
      aria-label="Close navigation menu"
      data-nav-backdrop
    ></button>

    <main id="main-content" class:list={["public-main", mainClass]} data-menu-background>
      <slot />
    </main>

    <footer class="site-footer" id="join" data-menu-background>
      <div class="footer-shell">
        <section class="footer-signup" aria-labelledby="footer-signup-title">
          <div class="footer-signup-copy">
            <p class="footer-signup-eyebrow"><span aria-hidden="true">✦</span> Android beta · Google Play</p>
            <h2 id="footer-signup-title">Join the Kingdom Kids launch list.</h2>
          </div>

          <form
            class="waitlist-form"
            action="/api/accounts/waitlist/"
            method="post"
            accept-charset="UTF-8"
            novalidate
            data-waitlist-form
          >
            <label class="sr-only" for="waitlist-email">Email address</label>
            <div class="waitlist-controls">
              <input
                id="waitlist-email"
                name="email"
                type="email"
                inputmode="email"
                autocomplete="email"
                maxlength="254"
                placeholder="you@example.com"
                aria-describedby="waitlist-status"
                required
                data-waitlist-email
              />
              <button class="waitlist-submit" type="submit" data-waitlist-submit>
                <span class="waitlist-button-label" data-waitlist-button-label>Join the waitlist</span>
                <span class="action-arrow" aria-hidden="true">&#x2197;&#xfe0e;</span>
              </button>
            </div>
            <p
              class="waitlist-status"
              id="waitlist-status"
              role="status"
              aria-live="polite"
              aria-atomic="true"
              data-waitlist-status
            ></p>
          </form>
        </section>

        <div class="footer-meta">
          <div class="footer-brand-block">
            <a class="brand brand--footer" href="/" aria-label="Kingdom Kids home">
              <span class="brand-symbol" aria-hidden="true"><i></i><i></i></span>
              <span>Kingdom Kids</span>
            </a>
            <p>Big stories for little hearts.</p>
          </div>

          <nav class="footer-nav" aria-label="Footer navigation">
            <div class="footer-nav-group">
              <p>Explore</p>
              <a href="/">Home</a>
              <a href="/#experience">Explore the app</a>
              <a href="/#faith-note">For grown-ups</a>
              <a href="/#faqs">FAQs</a>
            </div>
            <div class="footer-nav-group">
              <p>Privacy &amp; account</p>
              <a href="/privacy/" aria-current={currentPath === '/privacy/' ? 'page' : undefined}>Privacy</a>
              <a
                href="/account-deletion/"
                aria-current={currentPath === '/account-deletion/' ? 'page' : undefined}
              >Account deletion</a>
            </div>
          </nav>

          <a class="footer-return" href="#top">
            <span aria-hidden="true">↑</span>
            <small>Back to top</small>
          </a>
        </div>

        <div class="footer-bottom">
          <p>&copy; {currentYear} Kingdom Kids</p>
          <p>Faith <span aria-hidden="true">·</span> Wonder <span aria-hidden="true">·</span> Play</p>
        </div>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const pageBody = document.body;
        const menuToggle = document.querySelector('[data-menu-toggle]');
        const mobileMenu = document.querySelector('[data-mobile-menu]');
        const menuLabel = document.querySelector('[data-menu-label]');
        const navBackdrop = document.querySelector('[data-nav-backdrop]');
        const menuBackgroundRegions = document.querySelectorAll('[data-menu-background]');
        const waitlistForm = document.querySelector('[data-waitlist-form]');
        const waitlistEmail = document.querySelector('[data-waitlist-email]');
        const waitlistSubmit = document.querySelector('[data-waitlist-submit]');
        const waitlistButtonLabel = document.querySelector('[data-waitlist-button-label]');
        const waitlistStatus = document.querySelector('[data-waitlist-status]');
        let frame = 0;

        const menuFocusables = () => {
          if (!(menuToggle instanceof HTMLButtonElement) || !(mobileMenu instanceof HTMLElement)) return [];
          return [menuToggle, ...mobileMenu.querySelectorAll('a[href], button:not([disabled])')];
        };

        const setMenuState = (open, returnFocus = false) => {
          if (!(menuToggle instanceof HTMLButtonElement) || !(mobileMenu instanceof HTMLElement)) return;
          menuToggle.setAttribute('aria-expanded', String(open));
          mobileMenu.setAttribute('aria-hidden', String(!open));
          root.classList.toggle('menu-open', open);
          pageBody.classList.toggle('menu-open', open);
          menuBackgroundRegions.forEach((region) => {
            if (!(region instanceof HTMLElement)) return;
            if (open) region.setAttribute('inert', '');
            else region.removeAttribute('inert');
          });
          if (menuLabel) menuLabel.textContent = open ? 'Close navigation menu' : 'Open navigation menu';
          if (open) {
            window.requestAnimationFrame(() => {
              const firstLink = mobileMenu.querySelector('a[href]');
              if (firstLink instanceof HTMLElement) firstLink.focus();
            });
          } else if (returnFocus) menuToggle.focus();
        };

        menuToggle?.addEventListener('click', () => {
          if (menuToggle instanceof HTMLButtonElement) {
            setMenuState(menuToggle.getAttribute('aria-expanded') !== 'true');
          }
        });
        navBackdrop?.addEventListener('click', () => setMenuState(false, true));
        mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenuState(false)));

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && root.classList.contains('menu-open')) {
            setMenuState(false, true);
            return;
          }
          if (event.key !== 'Tab' || !root.classList.contains('menu-open')) return;
          const focusables = menuFocusables();
          if (focusables.length === 0) return;
          const first = focusables[0];
          const last = focusables[focusables.length - 1];
          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
          }
        });

        const setWaitlistState = (state, message, buttonLabel = 'Join the waitlist', emailIsInvalid = false) => {
          if (!(waitlistForm instanceof HTMLFormElement)) return;
          waitlistForm.dataset.state = state;
          waitlistForm.setAttribute('aria-busy', String(state === 'loading'));
          if (waitlistStatus) waitlistStatus.textContent = message;
          if (waitlistButtonLabel) waitlistButtonLabel.textContent = buttonLabel;
          if (waitlistSubmit instanceof HTMLButtonElement) {
            waitlistSubmit.disabled = state === 'loading' || state === 'success';
            waitlistSubmit.setAttribute('aria-disabled', String(state === 'success'));
          }
          if (waitlistEmail instanceof HTMLInputElement) {
            waitlistEmail.disabled = state === 'loading' || state === 'success';
            waitlistEmail.setAttribute('aria-invalid', String(emailIsInvalid));
          }
        };

        if (waitlistForm instanceof HTMLFormElement && waitlistEmail instanceof HTMLInputElement) {
          waitlistEmail.addEventListener('input', () => {
            if (waitlistForm.dataset.state === 'error') setWaitlistState('idle', '');
          });
          waitlistForm.addEventListener('submit', async (event) => {
            event.preventDefault();
            if (waitlistForm.dataset.state === 'success') return;
            if (!waitlistEmail.value.trim()) {
              setWaitlistState('error', 'Enter an email address to join the waitlist.', 'Join the waitlist', true);
              waitlistEmail.focus();
              return;
            }
            if (!waitlistEmail.validity.valid) {
              setWaitlistState('error', 'Enter a valid email address, such as name@example.com.', 'Join the waitlist', true);
              waitlistEmail.focus();
              return;
            }
            if (!navigator.onLine) {
              setWaitlistState('error', 'You appear to be offline. Reconnect and try again.');
              return;
            }

            setWaitlistState('loading', 'Sending your request…', 'Joining…');
            const controller = new AbortController();
            const requestTimeout = window.setTimeout(() => controller.abort(), 12000);
            try {
              const response = await fetch(waitlistForm.action, {
                method: 'POST',
                headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
                body: JSON.stringify({ email: waitlistEmail.value.trim() }),
                signal: controller.signal,
              });
              if (response.ok) {
                setWaitlistState('success', 'You’re on the list. We’ll let you know when the Android beta is ready.', 'Joined');
              } else if (response.status === 400) {
                setWaitlistState('error', 'Enter a valid email address, such as name@example.com.', 'Join the waitlist', true);
                waitlistEmail.focus();
              } else if (response.status === 429) {
                setWaitlistState('error', 'Too many attempts just now. Wait a moment, then try again.');
              } else {
                setWaitlistState('error', 'We couldn’t join the waitlist just now. Please try again.');
              }
            } catch {
              const message = navigator.onLine
                ? 'We couldn’t join the waitlist just now. Please try again.'
                : 'You appear to be offline. Reconnect and try again.';
              setWaitlistState('error', message);
            } finally {
              window.clearTimeout(requestTimeout);
            }
          });
        }

        const render = () => {
          frame = 0;
          const scrollRange = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
          const progress = Math.min(1, Math.max(0, window.scrollY / scrollRange));
          root.style.setProperty('--scroll-progress', progress.toFixed(4));
          pageBody.classList.toggle('nav-scrolled', window.scrollY > 18);
        };
        const requestRender = () => {
          if (!frame) frame = window.requestAnimationFrame(render);
        };
        window.addEventListener('scroll', requestRender, { passive: true });
        window.addEventListener('resize', () => {
          if (window.innerWidth > 900 && root.classList.contains('menu-open')) setMenuState(false);
          requestRender();
        }, { passive: true });
        window.addEventListener('pageshow', requestRender);
        requestRender();
      })();
    </script>
  </body>
</html>
