{
  "name": "kingdom-kids-motion-intro",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:visual": "remotion render src/index.ts KingdomKidsIntro out/visual.mp4 --codec=h264 --crf=14 --pixel-format=yuv420p --color-space=bt709 --muted --concurrency=50%",
    "render:poster": "remotion still src/index.ts KingdomKidsIntro out/kingdom-kids-intro-poster.png --frame=565",
    "score": "python3 scripts/generate_score.py"
  },
  "dependencies": {
    "@remotion/cli": "4.0.505",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.505"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "typescript": "5.7.3"
  }
}
