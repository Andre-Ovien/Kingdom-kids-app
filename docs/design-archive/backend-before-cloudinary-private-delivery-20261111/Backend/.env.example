# DJANGO_DEBUG is mandatory. Local development must opt in explicitly; a
# deployment with a missing variable fails closed instead of exposing debug.
DJANGO_DEBUG=true

# Optional only in explicit debug mode. Generate independent random production
# values instead of copying either placeholder.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_JWT_SIGNING_KEY=replace-with-a-separate-long-random-jwt-secret
DJANGO_JWT_ISSUER=kingdom-kids-api
DJANGO_JWT_AUDIENCE=kingdom-kids-mobile

# Optional in development, which accepts local/emulator/LAN hosts by default.
# Production must list exact public hostnames and cannot use *.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# Production verification uses row-level locks and therefore requires
# PostgreSQL. Local development may omit this value to use SQLite.
# DJANGO_DATABASE_URL=postgresql://kingdom_kids:change-me@localhost:5432/kingdom_kids
DJANGO_DB_CONN_MAX_AGE_SECONDS=60
DJANGO_DB_CONNECT_TIMEOUT_SECONDS=10
DJANGO_DB_STATEMENT_TIMEOUT_MS=15000
DJANGO_DB_IDLE_TRANSACTION_TIMEOUT_MS=30000
# Use verify-full plus DJANGO_DB_SSLROOTCERT when the provider supports it.
DJANGO_DB_SSLMODE=require
# DJANGO_DB_SSLROOTCERT=/run/secrets/postgres-ca.pem

# Required in production so throttles and readiness are shared by every worker.
# Prefer TLS. Set DJANGO_CACHE_ALLOW_INSECURE=true only for a provider's trusted
# private network where redis:// is explicitly required.
# DJANGO_CACHE_URL=rediss://default:change-me@redis.example.com:6379/0
DJANGO_CACHE_ALLOW_INSECURE=false
DJANGO_CACHE_CONNECT_TIMEOUT_SECONDS=3
DJANGO_CACHE_TIMEOUT_SECONDS=3

# Enable only when a trusted reverse proxy strips inbound copies of this header
# and sets X-Forwarded-Proto itself.
DJANGO_TRUST_X_FORWARDED_PROTO=false
# Number of trusted reverse proxies between the public client and Django.
# Keep 0 unless the ingress topology is known and strips spoofed forwarding headers.
DJANGO_API_NUM_PROXIES=0

# Set both only after every present and future subdomain is HTTPS-only and the
# domain meets the browser preload requirements.
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false

# External story/audio URLs are disabled unless their exact HTTPS hosts appear
# here. Bundled mobile assets do not require this setting.
DJANGO_CONTENT_MEDIA_HOSTS=cdn.example.com
# For cached production tracks/auditions, mount durable media here and serve
# matching relative paths from this owned HTTPS CDN/web-server base URL.
# Django itself serves /media/ only in explicit debug mode.
# DJANGO_MEDIA_ROOT=/var/lib/kingdom-kids/media
DJANGO_MEDIA_URL=/media/
DJANGO_MAX_NARRATOR_AUDIO_BYTES=10485760

DJANGO_DATA_UPLOAD_MAX_MEMORY_BYTES=1048576
DJANGO_FILE_UPLOAD_MAX_MEMORY_BYTES=5242880
DJANGO_DATA_UPLOAD_MAX_FIELDS=200
DJANGO_DATA_UPLOAD_MAX_FILES=5
MAX_KID_PROFILES=10
DJANGO_LOG_LEVEL=INFO

# Keep this independent from DJANGO_SECRET_KEY. Required in production and at
# least 32 random characters; rotating it invalidates outstanding email codes.
EMAIL_VERIFICATION_PEPPER=replace-with-an-independent-random-secret
EMAIL_VERIFICATION_TTL_SECONDS=600
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_ATTEMPT_WINDOW_SECONDS=600
EMAIL_VERIFICATION_LOCKOUT_SECONDS=900

# Keep this independent from every other signing secret. Reset requests return
# the same response for unknown and ineligible accounts.
PASSWORD_RESET_PEPPER=replace-with-an-independent-password-reset-secret
PASSWORD_RESET_TTL_SECONDS=300
PASSWORD_RESET_MAX_ATTEMPTS=5
# Local test fixtures only; leave disabled for normal/live mail delivery.
PASSWORD_RESET_PRINT_LOCAL_TEST_CODES=false
PASSWORD_RESET_LOCAL_TEST_EMAILS=

# Keep this independent from every other signing secret. These codes authorize
# an irreversible account deletion and are never printed by the console backend.
ACCOUNT_DELETION_PEPPER=replace-with-an-independent-account-deletion-secret
ACCOUNT_DELETION_TTL_SECONDS=600
ACCOUNT_DELETION_MAX_ATTEMPTS=5
AUTH_CHALLENGE_RETENTION_DAYS=30

# Development uses the console backend below. Production must replace it with
# SMTP (django.core.mail.backends.smtp.EmailBackend) or a provider backend.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=no-reply@localhost
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_USE_SSL=false
DJANGO_EMAIL_TIMEOUT_SECONDS=10

# Resend can use the same built-in SMTP transport; no browser/mobile key is used.
# Set all of these in the backend's environment after verifying the sender domain.
# The notify subdomain below is an example, not a claim that DNS is configured.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_DEFAULT_FROM_EMAIL=Kingdom Kids <no-reply@notify.kingdom-kids.app>
# DJANGO_EMAIL_HOST=smtp.resend.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=resend
# DJANGO_EMAIL_HOST_PASSWORD=
# RESEND_API_KEY= (store the actual sending-only key in your secret manager)
# DJANGO_EMAIL_USE_TLS=true
# DJANGO_EMAIL_USE_SSL=false

# Disabled Square SANDBOX foundation only. Leave secrets blank until separately configured.
# Never expose tokens to Flutter. Checkout/reconciliation and access stay disabled.
SQUARE_SANDBOX_ENABLED=false
SQUARE_ENVIRONMENT=sandbox
SQUARE_API_VERSION=2026-09-16
SQUARE_SANDBOX_ACCESS_TOKEN=
SQUARE_SANDBOX_MERCHANT_ID=
SQUARE_SANDBOX_LOCATION_ID=
SQUARE_SANDBOX_WEBHOOK_SIGNATURE_KEY=
SQUARE_SANDBOX_WEBHOOK_NOTIFICATION_URL=
SQUARE_HTTP_TIMEOUT_SECONDS=5
SQUARE_WEBHOOK_MAX_BODY_BYTES=262144
SQUARE_SANDBOX_CHECKOUT_ENABLED=false
SQUARE_SANDBOX_RECONCILIATION_ENABLED=false
SQUARE_SANDBOX_CANCELLATION_ENABLED=false
SQUARE_SANDBOX_PLAN_VARIATION_ID=
# SQUARE_SANDBOX_TRANSPORT_FACTORY is a server-side callable injection, deliberately
# None in settings, not an env-imported/default HTTP sender. Explicitly review
# and supply a bounded, no-redirect transport for separately authorized canaries.

# Future paid-content rollout stays OFF until checkout, verification and delivery are ready.
PAID_CONTENT_ENFORCEMENT_ENABLED=false
PAID_CONTENT_ENTITLEMENT_ENVIRONMENT=production
